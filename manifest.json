{
  "manifest_version": 3,
  "name": "看看学 - 看视频学拼音生字 + 数学练习",
  "version": "0.3.1",
  "description": "看完B站视频根据字幕做拼音生字小游戏；也可随时做加减法数学练习，边玩边学。",
  "icons": {
    "16": "src/assets/icons/icon16.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png"
  },
  "permissions": ["sidePanel", "storage", "tts", "tabs", "scripting"],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://aisubtitle.hdslb.com/*",
    "https://*.hdslb.com/*",
    "https://*.bilibili.com/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.bilibili.com/video/*", "https://*.bilibili.com/bangumi/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "options_page": "src/options/index.html",
  "action": {
    "default_title": "看看学",
    "default_icon": {
      "16": "src/assets/icons/icon16.png",
      "48": "src/assets/icons/icon48.png",
      "128": "src/assets/icons/icon128.png"
    }
  }
}
